        "page_path": "string",
        "has_cta": "boolean"
      }
    },
    {
      "event_type": "SCROLL_INTERACTION",
      "data_fields": [
        "action",
        "depth_percentage",
        "milestone",
        "page_path",
        "direction"
      ],
      "properties": {
        "action": "\"depth_reached\"",
