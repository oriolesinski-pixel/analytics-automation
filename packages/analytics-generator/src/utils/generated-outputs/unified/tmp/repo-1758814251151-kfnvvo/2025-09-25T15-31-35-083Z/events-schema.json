        "page_path": "string",
        "fields_total": "number",
        "fields_completed": "number"
      }
    },
    {
      "event_type": "ELEMENT_VISIBILITY",
      "data_fields": [
        "action",
        "element_type",
        "element_name",
        "element_id",
        "trigger_source",
        "page_path",
        "has_cta"
      ],
      "properties": {
        "action": "\"shown\" | \"hidden\" | \"dismissed\"",
