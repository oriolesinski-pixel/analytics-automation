    {
      "event_type": "BUTTON_CLICK",
      "data_fields": [
        "element_text",
        "element_id",
        "element_type",
        "surface",
        "page_path",
        "is_primary_cta",
        "cta_category"
      ],
      "properties": {
        "element_text": "string",
        "element_id": "string | null",
