    },
    {
      "event_type": "FORM_INTERACTION",
      "data_fields": [
        "action",
        "form_name",
        "form_id",
        "form_type",
        "surface",
        "page_path",
        "fields_total",
        "fields_completed"
      ],
      "properties": {
        "action": "\"started\" | \"submitted\" | \"abandoned\"",
        "form_name": "string",
        "form_id": "string | null",
