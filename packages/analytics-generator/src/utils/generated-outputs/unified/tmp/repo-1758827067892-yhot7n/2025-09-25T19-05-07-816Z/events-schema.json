    {
      "event_type": "SCROLL_INTERACTION",
      "data_fields": [
        "action",
        "depth_percentage",
        "milestone",
        "page_path",
        "direction"
      ],
      "properties": {
        "action": "\"depth_reached\"",
        "depth_percentage": "number",
        "milestone": "\"25%\" | \"50%\" | \"75%\" | \"90%\" | \"100%\" | \"none\"",
        "page_path": "string",
        "direction": "\"up\" | \"down\""
      }
    }
