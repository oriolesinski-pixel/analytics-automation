  "events": [
    {
      "event_type": "PAGE_VIEW",
      "data_fields": [
        "url",
        "path",
        "title",
        "referrer",
        "is_first_view",
        "entry_type"
      ],
      "properties": {
        "url": "string",
        "path": "string",
        "title": "string",
        "referrer": "string | null",
        "is_first_view": "boolean",
        "entry_type": "\"navigation\" | \"reload\" | \"back_forward\" | \"spa_transition\""
